        "TradeAction": { "$className": "RemoteEvent" },
        "TradeEvent": { "$className": "RemoteEvent" },
        "Grappled": { "$className": "RemoteEvent" },
        "ClaimIndex": { "$className": "RemoteEvent" },
        "IndexClaimed": { "$className": "RemoteEvent" },
        "StealResult": { "$className": "RemoteEvent" },
        "StealPet": { "$className": "RemoteEvent" },
        "StopTraining": { "$className": "RemoteEvent" },
